<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ComicReaderApp.AddBookPage"
             Title="{Binding PageTitle}"
             >
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Title *" FontAttributes="Bold"/>
            <Entry Text="{Binding Title}" Placeholder="Required"/>

            <Label Text="Author"/>
            <Entry Text="{Binding Author}"/>

            <Label Text="Year"/>
            <Entry Text="{Binding Year}" Keyboard="Numeric"/>

            <Label Text="Publisher"/>
            <Entry Text="{Binding Publisher}"/>

            <Label Text="ISBN"/>
            <Entry Text="{Binding Isbn}"/>

            <Button Text="{Binding PickedFileName}" Command="{Binding PickFileCommand}"/>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}"/>

            <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>